{
  "name": "antigravity-usage-intelligence",
  "displayName": "Antigravity 用量与配额智能监控 (Token Tracker & Quota Intelligence)",
  "description": "Antigravity Token 用量分析与实时模型配额监控看板。精准支持 Gemini & Claude Token 统计、Prompt 缓存节省估算、24 小时活跃分布与会话明细。100% 本地运行与隐私安全。",
  "version": "1.0.7",
  "publisher": "nirbhay-hiwse",
  "author": {
    "name": "Nirbhay Hiwse",
    "url": "https://github.com/Nir-Bhay"
  },
  "license": "MIT",
  "preview": false,
  "pricing": "Free",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Antigravity-Verified-blue?logo=google&logoColor=white&color=3b82f6",
      "href": "https://github.com/Nir-Bhay/antigravity-usage-intelligence",
      "description": "Built for Google Antigravity"
    },
    {
      "url": "https://img.shields.io/badge/License-MIT-emerald?color=10b981",
      "href": "https://github.com/Nir-Bhay/antigravity-usage-intelligence/blob/main/LICENSE",
      "description": "MIT License"
    },
    {
      "url": "https://img.shields.io/badge/Privacy-100%25%20Local-purple?color=8b5cf6",
      "href": "https://github.com/Nir-Bhay/antigravity-usage-intelligence#readme",
      "description": "Zero Telemetry / 100% Local"
    },
    {
      "url": "https://img.shields.io/badge/Cost_Tracking-Gemini_Prompt_Cache-orange?color=f59e0b",
      "href": "https://github.com/Nir-Bhay/antigravity-usage-intelligence#readme",
      "description": "Gemini Prompt Caching & Cost Intelligence"
    }
  ],
  "keywords": [
    "antigravity",
    "antigravity-usage",
    "ag-usage",
    "antigravity-quota",
    "antigravity-token",
    "antigravity-tracker",
    "antigravity-panel",
    "antigravity-stats",
    "quota-monitor",
    "quota-tracker",
    "token-usage",
    "token-tracker",
    "token-counter",
    "usage-tracker",
    "usage-intelligence",
    "gemini",
    "claude",
    "gemini-quota",
    "claude-quota",
    "prompt-caching",
    "cache-savings",
    "llm-cost",
    "cost-tracker",
    "thinking-tokens",
    "ai-agent",
    "activity-heatmap",
    "agent-analytics",
    "session-analytics",
    "session-forensics",
    "ai-coding-telemetry",
    "developer-productivity",
    "privacy-first",
    "local-only"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Visualization",
    "Productivity",
    "Other"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravity-stats-view"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Antigravity 用量监控配置",
      "properties": {
        "antigravity-stats.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在底部状态栏显示今日 Token 消耗角标。"
        },
        "antigravity-stats.autoRefreshMinutes": {
          "type": "number",
          "default": 3,
          "description": "Token 用量自动刷新的时间间隔（分钟）。"
        },
        "antigravity-stats.defaultRange": {
          "type": "string",
          "default": "today",
          "enum": [
            "today",
            "yesterday",
            "7d",
            "30d",
            "90d",
            "180d",
            "all"
          ],
          "description": "打开分析面板时默认加载的时间跨度。"
        },
        "antigravity-stats.pythonPath": {
          "type": "string",
          "default": "",
          "description": "显式指定 Python 解释器路径（如 C:\\\\Python311\\\\python.exe 或 /usr/bin/python3）。留空则自动检测。"
        },
        "antigravity-stats.quotaAlerts": {
          "type": "boolean",
          "default": true,
          "description": "当 Antigravity 实时配额达到警戒阈值时弹出警告通知（仅对官方实时配额生效）。"
        },
        "antigravity-stats.quotaAlertThresholds": {
          "type": "array",
          "default": [75, 90, 100],
          "description": "触发配额警告通知的使用率百分比阈值（按模型类别），当使用率下降 5% 后自动重新激活。"
        },
        "antigravity-stats.demoMode": {
          "type": "boolean",
          "default": false,
          "description": "演示模式：展示样本演示数据而非读取真实本地数据库（用于界面截图与功能预览）。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-stats-container",
          "title": "Agent 统计",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-stats-container": [
        {
          "type": "webview",
          "id": "antigravity-stats-view",
          "name": "Antigravity 用量统计"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-stats.openDashboard",
        "title": "打开全屏用量仪表盘",
        "icon": "$(dashboard)"
      },
      {
        "command": "antigravity-stats.refresh",
        "title": "刷新用量统计",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-stats.rebuildCache",
        "title": "重建全量历史缓存",
        "icon": "$(database)"
      },
      {
        "command": "antigravity-stats.exportReport",
        "title": "导出 Token 用量分析报告 (JSON)",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity-stats.openDashboard",
          "when": "view == antigravity-stats-view",
          "group": "navigation@1"
        },
        {
          "command": "antigravity-stats.refresh",
          "when": "view == antigravity-stats-view",
          "group": "navigation@2"
        },
        {
          "command": "antigravity-stats.rebuildCache",
          "when": "view == antigravity-stats-view",
          "group": "navigation@3"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realignmaent/antigravity-usage-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/realignmaent/antigravity-usage-intelligence/issues"
  },
  "homepage": "https://github.com/realignmaent/antigravity-usage-intelligence#readme",
  "scripts": {
    "test": "node -c extension.js && node -c src/quota_detector.js && (python3 -m py_compile collector.py || python -m py_compile collector.py || py -3 -m py_compile collector.py)",
    "vscode:prepublish": "npm run test",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.9.3"
  }
}